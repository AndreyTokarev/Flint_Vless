#!/bin/sh
# Switch the Xray VLESS REALITY node and routing mode.
# Usage: flint-node [list|codes|names|apply|<code>]
#        flint-node use <code>     switch without the exit IP check
#        flint-node current        current server code (empty when there are no servers)
#        flint-node routing [ru|global]
#        flint-node vpn [on|off]   off = LAN clients go to the internet directly, bypassing Xray
#                                  (so they do while there are no servers at all)
#        flint-node site list | add direct|proxy <site> | del <site>
#        flint-node direct | direct add <mac> [name] | direct del <mac>
#                                  LAN devices that always go online directly, bypassing Xray (firewall.user)
#   ru     - Russian sites/IPs go direct, the rest via VPN (needs /usr/share/xray/geo*.dat)
#   global - everything via VPN
#   custom sites (domains incl. subdomains, IPv4, CIDR) override the geo filter in both modes
. /usr/share/flint/lib.sh
ENV=/etc/xray/flint.env
TEMPLATE=/etc/xray/template.json
CONF=/etc/xray/config.json
MODE_FILE=/etc/xray/routing-mode
VPN_FILE=/etc/xray/vpn-state
SITES=/etc/xray/custom-sites
GEO=/usr/share/xray

nodes() { node_lines $(node_files); }
# Current server code: empty when there are no servers (panel / flint-node current).
current() { [ -s "$CONF" ] || return 0; cat "$CUR" 2>/dev/null || true; }
mode() { cat "$MODE_FILE" 2>/dev/null || echo ru; }
sub_hosts() { host_of "$(echo "$SUB_URL"; cut -f2 "$SUBS" 2>/dev/null)"; }
vpn_state() { cat "$VPN_FILE" 2>/dev/null || echo on; }
# pick: sets pick_code (and pick_switched=1 when a previous current code is gone).
pick() {
	pick_switched=
	pick_code="$(cat "$CUR" 2>/dev/null || true)"
	if [ -n "$pick_code" ] && nodes | awk '{print $1}' | grep -qx "$pick_code"; then
		return 0
	fi
	prev="$pick_code"
	pick_code="$(nodes | awk 'NR == 1 { print $1 }')"
	if [ -n "$prev" ] && [ -n "$pick_code" ]; then pick_switched=1; fi
}

# Provider server names (address + REALITY SNI of every node) routed direct, so a VPN
# client on a Flint device (e.g. Happ) does not get tunnelled into the same provider twice.
# Subscription hosts go direct too: Happ on a LAN device must refresh them while the current node is down.
provider_domains() {
	{ nodes | awk '{print $2; print $3}'; sub_hosts; } | grep -v -E '^([0-9.]+)?$' | sort -u |
		sed 's/.*/"full:&"/' | tr '\n' ',' | sed 's/,$//; s/,/, /g'
}

# Custom sites as a JSON list: sites_json direct|proxy domain|ip
sites_json() {
	[ -f "$SITES" ] || return 0
	awk -v l="$1" -v t="$2" '$1 == l {
		ip = ($2 ~ /^[0-9]+(\.[0-9]+){3}(\/[0-9]+)?$/)
		if (t == "ip" && ip) print "\"" $2 "\""
		if (t == "domain" && !ip) print "\"domain:" $2 "\""
	}' "$SITES" | tr '\n' ',' | sed 's/,$//; s/,/, /g'
}

# "https://www.Example.com:8080/path" -> example.com; IPv4 and CIDR pass through.
normalize_site() {
	s="$(echo "$1" | tr 'A-Z' 'a-z' | sed 's|^[a-z]*://||')"
	if echo "$s" | grep -qE '^[0-9]+(\.[0-9]+){3}(/[0-9]+)?$'; then echo "$s"; return; fi
	echo "$s" | sed -e 's|[/?#].*$||' -e 's|^www\.||' -e 's|:[0-9]*$||' |
		grep -E '^([a-z0-9-]+\.)+[a-z0-9-]{2,}$' || true
}

render() {
	IFS="$TAB" read -r _ _ host port uuid sni pbk sid net svc _ <<EOF
$(nodes_tsv | awk -F '\t' -v c="$1" '$1 == c' | head -n1)
EOF
	[ "$sid" = - ] && sid=""
	[ "$svc" = - ] && svc=""
	if [ "$net" = tcp ]; then flow=xtls-rprx-vision; else flow=""; fi
	cdi="$(sites_json direct ip)"; cpi="$(sites_json proxy ip)"
	if [ "$RENDER_MODE" = ru ] || [ -n "$cdi$cpi" ]; then strategy=IPIfNonMatch; else strategy=AsIs; fi
	umask 077
	sed -e "s|__UUID__|$uuid|" -e "s|__ADDR__|$host|" -e "s|__PORT__|$port|" -e "s|__SNI__|$sni|" \
		-e "s|__PBK__|$pbk|" -e "s|__SID__|$sid|" -e "s|__DOMAIN_STRATEGY__|$strategy|" \
		-e "s|__NET__|$net|" -e "s|__FLOW__|$flow|" -e "s|__GRPC_SERVICE__|$svc|" \
		-e "s|__PROVIDER_DOMAINS__|$(provider_domains)|" \
		-e "s|__CUSTOM_PROXY_DOMAIN__|$(sites_json proxy domain)|" -e "s|__CUSTOM_PROXY_IP__|$cpi|" \
		-e "s|__CUSTOM_DIRECT_DOMAIN__|$(sites_json direct domain)|" -e "s|__CUSTOM_DIRECT_IP__|$cdi|" \
		"$TEMPLATE" > "$CONF.new"
	sed -i '/": \[\] }/d' "$CONF.new"
	if [ "$RENDER_MODE" != ru ]; then
		sed -i -e '/geosite:category-ru/d' -e '/"geoip:ru"/d' "$CONF.new"
	fi
	XRAY_LOCATION_ASSET=$GEO xray run -test -format json -c "$CONF.new" > /tmp/flint-xray-test.log 2>&1
}

# apply [code]: with a code — switch to that server (unknown = error); without — pick() chooses.
# No servers: Xray stays down and firewall.user lets LAN go direct (message only when leaving a configured state).
apply() {
	. "$ENV"
	if [ -z "$(nodes)" ]; then
		had=
		[ -s "$CONF" ] && had=1
		/etc/init.d/xray stop >/dev/null 2>&1 || true
		rm -f "$CONF" "$CUR"
		sh /etc/firewall.user >/dev/null 2>&1 || true
		[ -n "$had" ] || return 0
		t "Серверов пока нет: устройства ходят в интернет напрямую. Добавьте подписку на вкладке «Подписки» или свой сервер." \
			"No servers yet: devices go online directly. Add a subscription on the Subscriptions tab or an own server."
		return 0
	fi
	if [ -n "$1" ]; then
		code="$1"
		nodes | awk '{print $1}' | grep -qx "$code" || fail "Unknown: $code"
	else
		pick
		code="$pick_code"
		[ -n "$pick_switched" ] && t "Текущего сервера больше нет, переключаюсь на $code" \
			"The current server is gone, switching to $code"
	fi
	RENDER_MODE="$(mode)"
	if ! render "$code"; then
		if [ "$RENDER_MODE" = ru ]; then
			echo "RU routing unavailable (geo files missing or broken), using global"
			RENDER_MODE=global
			render "$code" || fail "Config test failed: $(tail -n 3 /tmp/flint-xray-test.log)"
		else
			fail "Config test failed: $(tail -n 3 /tmp/flint-xray-test.log)"
		fi
	fi
	mv "$CONF.new" "$CONF" && echo "$code" > "$CUR" || fail "Cannot write $CONF"
	/etc/init.d/xray restart 2>/dev/null || fail "Xray did not restart"
	sh /etc/firewall.user >/dev/null 2>&1 || true
	echo "Node: $code, routing: $RENDER_MODE"
}

cmd="${1:-list}"
case "$cmd" in
	list)
		echo "Current: $(current), routing: $(mode), vpn: $(vpn_state)"
		echo "Codes: $(nodes | awk '{print $1}' | tr '\n' ' ')"
		;;
	codes)
		nodes | awk '{print $1}'
		;;
	names)
		# "code<TAB>name<TAB>ip|domain<TAB>group"; the name is the comment line right above the node.
		# "ip" = subscription node with a bare IP (the panel's white list group); own nodes are always "domain".
		# group: subscription id (nodes.d/<id>.conf), "own", or "-" for manual nodes.conf.
		nodes_tsv | awk -F '\t' -v OFS='\t' '{ print $1, $2, ($3 ~ /^[0-9.]+$/ && $11 != "own" ? "ip" : "domain"), $11 }'
		;;
	current)
		current
		;;
	routing)
		[ -n "$2" ] || { mode; exit 0; }
		case "$2" in ru|global) ;; *) fail "Usage: flint-node routing [ru|global]" ;; esac
		echo "$2" > "$MODE_FILE" || fail "Cannot write $MODE_FILE"
		apply
		;;
	apply)
		apply
		;;
	use)
		apply "$2"
		;;
	site)
		case "$2" in
			list|"")
				[ -f "$SITES" ] && awk 'NF == 2 { print $1 "\t" $2 }' "$SITES"
				exit 0 ;;
			add)
				case "$3" in direct|proxy) ;; *) fail "Usage: flint-node site add direct|proxy <site>" ;; esac
				site="$(normalize_site "$4")"
				[ -n "$site" ] || fail "Not a domain or IP: $4"
				touch "$SITES" && { awk -v s="$site" '$2 != s' "$SITES"; echo "$3 $site"; } > "$SITES.new" &&
					mv "$SITES.new" "$SITES" || fail "Cannot write $SITES"
				echo "Added: $site -> $3" ;;
			del)
				site="$(normalize_site "$3")"
				[ -n "$site" ] && [ -f "$SITES" ] || fail "Not found: $3"
				awk -v s="$site" '$2 != s' "$SITES" > "$SITES.new" && mv "$SITES.new" "$SITES" || fail "Cannot write $SITES"
				echo "Removed: $site" ;;
			*)
				fail "Usage: flint-node site list | add direct|proxy <site> | del <site>" ;;
		esac
		apply
		;;
	vpn)
		[ -n "$2" ] || { vpn_state; exit 0; }
		case "$2" in on|off) ;; *) fail "Usage: flint-node vpn [on|off]" ;; esac
		echo "$2" > "$VPN_FILE" || fail "Cannot write $VPN_FILE"
		sh /etc/firewall.user >/dev/null 2>&1 || fail "Firewall update failed"
		echo "VPN: $2"
		;;
	direct)
		m="$(mac "$3")"
		case "$2" in
			"") direct_devices ;;
			add)
				[ -n "$m" ] || fail "$(t "Это не MAC-адрес: $3" "Not a MAC address: $3")"
				direct_devices | cut -f1 | grep -qxF "$m" && fail "$(t "Это устройство уже без VPN" "This device already bypasses the VPN")"
				name="$(printf '%s' "$4" | tr -d '\t\r\n' | cut -c1-40)"
				[ -n "$name" ] || name="$(devices | awk -F '\t' -v m="$m" '$1 == m { print ($3 != "" ? $3 : $2) }' | head -n1)"
				printf '%s\t%s\n' "$m" "${name:-$m}" >> "$DIRECT" || fail "Cannot write $DIRECT"
				sh /etc/firewall.user >/dev/null 2>&1 || fail "Firewall update failed"
				t "Без VPN: ${name:-$m}" "Without VPN: ${name:-$m}"
				;;
			del)
				direct_devices | cut -f1 | grep -qxF "$m" || fail "$(t "Нет такого устройства" "No such device")"
				direct_devices | awk -F '\t' -v m="$m" '$1 != m' > "$DIRECT.new" && mv "$DIRECT.new" "$DIRECT" || fail "Cannot write $DIRECT"
				sh /etc/firewall.user >/dev/null 2>&1 || fail "Firewall update failed"
				t "Устройство снова через VPN" "The device goes via VPN again"
				;;
			*) fail "flint-node direct | direct add <mac> [name] | direct del <mac>" ;;
		esac
		;;
	*)
		apply "$cmd"
		sleep 1
		curl -s -m 15 -x http://127.0.0.1:1087 https://ifconfig.me; echo
		;;
esac


#!/bin/sh
# Switch the Xray VLESS REALITY node and routing mode.
# Usage: flint-node [list|codes|names|apply|<code>]
#        flint-node use <code>     switch without the exit IP check
#        flint-node routing [ru|global]
#        flint-node vpn [on|off]   off = LAN clients go to the internet directly, bypassing Xray
#        flint-node site list | add direct|proxy <site> | del <site>
#   ru     - Russian sites/IPs go direct, the rest via VPN (needs /usr/share/xray/geo*.dat)
#   global - everything via VPN
#   custom sites (domains incl. subdomains, IPv4, CIDR) override the geo filter in both modes
set -e
ENV=/etc/xray/flint.env
NODES=/etc/xray/nodes.conf
CUSTOM=/etc/xray/nodes-custom.conf
SUBS=/etc/xray/subscriptions
TEMPLATE=/etc/xray/template.json
CONF=/etc/xray/config.json
CUR=/etc/xray/current-node
MODE_FILE=/etc/xray/routing-mode
VPN_FILE=/etc/xray/vpn-state
SITES=/etc/xray/custom-sites
GEO=/usr/share/xray

node_files() { for f in "$NODES" "$CUSTOM"; do [ -f "$f" ] && echo "$f"; done; }
nodes() { cat $(node_files) | grep -v -E '^[[:space:]]*(#|$)'; }
current() { cat "$CUR" 2>/dev/null || nodes | awk 'NR == 1 {print $1}'; }
mode() { cat "$MODE_FILE" 2>/dev/null || echo ru; }
sub_hosts() { { echo "$SUB_URL"; cut -f2 "$SUBS" 2>/dev/null; } | sed -e 's|^[a-zA-Z]*://||' -e 's|[/:?#].*||'; }
vpn_state() { cat "$VPN_FILE" 2>/dev/null || echo on; }

# Provider server names (address + REALITY SNI of every node) routed direct, so a VPN
# client on a Flint device (e.g. Happ) does not get tunnelled into the same provider twice.
# Subscription hosts go direct too: Happ on a LAN device must refresh them while the current node is down.
provider_domains() {
	{ nodes | awk '{print $2; print $3}'; sub_hosts; } | grep -v -E '^([0-9.]+)?$' | sort -u |
		sed 's/.*/"full:&"/' | tr '\n' ',' | sed 's/,$//; s/,/, /g'
}

# Custom sites as a JSON list: sites_json direct|proxy domain|ip
sites_json() {
	[ -f "$SITES" ] || return 0
	awk -v l="$1" -v t="$2" '$1 == l {
		ip = ($2 ~ /^[0-9]+(\.[0-9]+){3}(\/[0-9]+)?$/)
		if (t == "ip" && ip) print "\"" $2 "\""
		if (t == "domain" && !ip) print "\"domain:" $2 "\""
	}' "$SITES" | tr '\n' ',' | sed 's/,$//; s/,/, /g'
}

# "https://www.Example.com:8080/path" -> example.com; IPv4 and CIDR pass through.
normalize_site() {
	s="$(echo "$1" | tr 'A-Z' 'a-z' | sed 's|^[a-z]*://||')"
	if echo "$s" | grep -qE '^[0-9]+(\.[0-9]+){3}(/[0-9]+)?$'; then echo "$s"; return; fi
	echo "$s" | sed -e 's|[/?#].*$||' -e 's|^www\.||' -e 's|:[0-9]*$||' |
		grep -E '^([a-z0-9-]+\.)+[a-z0-9-]{2,}$' || true
}

render() {
	line="$(nodes | awk -v c="$1" '$1 == c' | head -n1)"
	set -- $line
	uuid="${6:-$VLESS_UUID}"
	port="${7:-443}"
	sid="$5"; [ "$sid" = - ] && sid=""
	net="${8:-tcp}"; svc="${9:--}"; [ "$svc" = - ] && svc=""
	if [ "$net" = tcp ]; then flow=xtls-rprx-vision; else flow=""; fi
	cdi="$(sites_json direct ip)"; cpi="$(sites_json proxy ip)"
	if [ "$RENDER_MODE" = ru ] || [ -n "$cdi$cpi" ]; then strategy=IPIfNonMatch; else strategy=AsIs; fi
	umask 077
	sed -e "s|__UUID__|$uuid|" -e "s|__ADDR__|$2|" -e "s|__PORT__|$port|" -e "s|__SNI__|$3|" \
		-e "s|__PBK__|$4|" -e "s|__SID__|$sid|" -e "s|__DOMAIN_STRATEGY__|$strategy|" \
		-e "s|__NET__|$net|" -e "s|__FLOW__|$flow|" -e "s|__GRPC_SERVICE__|$svc|" \
		-e "s|__PROVIDER_DOMAINS__|$(provider_domains)|" \
		-e "s|__CUSTOM_PROXY_DOMAIN__|$(sites_json proxy domain)|" -e "s|__CUSTOM_PROXY_IP__|$cpi|" \
		-e "s|__CUSTOM_DIRECT_DOMAIN__|$(sites_json direct domain)|" -e "s|__CUSTOM_DIRECT_IP__|$cdi|" \
		"$TEMPLATE" > "$CONF.new"
	sed -i '/": \[\] }/d' "$CONF.new"
	if [ "$RENDER_MODE" != ru ]; then
		sed -i -e '/geosite:category-ru/d' -e '/"geoip:ru"/d' "$CONF.new"
	fi
	XRAY_LOCATION_ASSET=$GEO xray run -test -format json -c "$CONF.new" > /tmp/flint-xray-test.log 2>&1
}

apply() {
	code="$1"
	nodes | awk '{print $1}' | grep -qx "$code" || { echo "Unknown: $code"; exit 1; }
	. "$ENV"
	RENDER_MODE="$(mode)"
	if ! render "$code"; then
		if [ "$RENDER_MODE" = ru ]; then
			echo "RU routing unavailable (geo files missing or broken), using global"
			RENDER_MODE=global
			render "$code" || { echo "Config test failed:"; tail -n 3 /tmp/flint-xray-test.log; exit 1; }
		else
			echo "Config test failed:"; tail -n 3 /tmp/flint-xray-test.log; exit 1
		fi
	fi
	mv "$CONF.new" "$CONF"
	echo "$code" > "$CUR"
	/etc/init.d/xray restart
	sh /etc/firewall.user >/dev/null 2>&1 || true
	echo "Node: $code, routing: $RENDER_MODE"
}

cmd="${1:-list}"
case "$cmd" in
	list)
		echo "Current: $(current), routing: $(mode), vpn: $(vpn_state)"
		echo "Codes: $(nodes | awk '{print $1}' | tr '\n' ' ')"
		;;
	codes)
		nodes | awk '{print $1}'
		;;
	names)
		# "code<TAB>name<TAB>ip|domain<TAB>group"; the name is the comment line right above the node.
		# "ip" = subscription node with a bare IP (the panel's white list group); own nodes are always "domain".
		# group: subscription id from the "#@" line (see flint-sub-update), "own" for own nodes.
		first="$(head -n1 "$SUBS" 2>/dev/null | cut -f1)"
		awk -v own="$CUSTOM" -v first="${first:--}" 'FNR == 1 { g = (FILENAME == own) ? "own" : first }
			/^#@/ { if (FILENAME != own) g = $2; name = ""; next }
			/^[[:space:]]*#/ { sub(/^[[:space:]]*#[[:space:]]*/, ""); name = $0; next }
			/^[[:space:]]*$/ { next }
			{ print $1 "\t" ((name != "" && name !~ /^Generated/) ? name : $1) "\t" ($2 ~ /^[0-9.]+$/ && FILENAME != own ? "ip" : "domain") "\t" g; name = "" }' $(node_files)
		;;
	routing)
		[ -n "$2" ] || { mode; exit 0; }
		case "$2" in ru|global) ;; *) echo "Usage: flint-node routing [ru|global]"; exit 1 ;; esac
		echo "$2" > "$MODE_FILE"
		apply "$(current)"
		;;
	apply)
		apply "$(current)"
		;;
	use)
		apply "$2"
		;;
	site)
		case "$2" in
			list|"")
				[ -f "$SITES" ] && awk 'NF == 2 { print $1 "\t" $2 }' "$SITES"
				exit 0 ;;
			add)
				case "$3" in direct|proxy) ;; *) echo "Usage: flint-node site add direct|proxy <site>"; exit 1 ;; esac
				site="$(normalize_site "$4")"
				[ -n "$site" ] || { echo "Not a domain or IP: $4"; exit 1; }
				touch "$SITES"
				awk -v s="$site" '$2 != s' "$SITES" > "$SITES.new"
				echo "$3 $site" >> "$SITES.new"
				mv "$SITES.new" "$SITES"
				echo "Added: $site -> $3" ;;
			del)
				site="$(normalize_site "$3")"
				[ -n "$site" ] && [ -f "$SITES" ] || { echo "Not found: $3"; exit 1; }
				awk -v s="$site" '$2 != s' "$SITES" > "$SITES.new"
				mv "$SITES.new" "$SITES"
				echo "Removed: $site" ;;
			*)
				echo "Usage: flint-node site list | add direct|proxy <site> | del <site>"; exit 1 ;;
		esac
		apply "$(current)"
		;;
	vpn)
		[ -n "$2" ] || { vpn_state; exit 0; }
		case "$2" in on|off) ;; *) echo "Usage: flint-node vpn [on|off]"; exit 1 ;; esac
		echo "$2" > "$VPN_FILE"
		sh /etc/firewall.user >/dev/null 2>&1
		echo "VPN: $2"
		;;
	*)
		apply "$cmd"
		sleep 1
		curl -s -m 15 -x http://127.0.0.1:1087 https://ifconfig.me; echo
		;;
esac

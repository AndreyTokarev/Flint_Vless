#!/bin/sh
# Own VLESS REALITY nodes, kept in nodes-custom.conf apart from the subscription list
# (gru-sub-update never touches them). Same format as nodes.conf.
# Usage: gru-custom list                  code<TAB>name of own nodes
#        gru-custom show <code>           code name address port uuid sni pbk sid (TAB-separated, any node)
#        gru-custom link <vless://...>    add a node from a share link
#        gru-custom set <code|new> <name> <address> <port> <uuid> <sni> <pbk> [sid]
#        gru-custom del <code>
set -e
ENV=/etc/xray/gru.env
NODES=/etc/xray/nodes.conf
CUSTOM=/etc/xray/nodes-custom.conf
CUR=/etc/xray/current-node
PARSER=/usr/share/gru/vless.awk
TAB="$(printf '\t')"

# "code name address port uuid sni pbk sid" (TAB-separated) for every node in the given files.
entries() {
	for f in "$@"; do [ -f "$f" ] && cat "$f"; done | awk -v u="$VLESS_UUID" '
		/^[[:space:]]*#/ { sub(/^[[:space:]]*#[[:space:]]*/, ""); name = $0; next }
		/^[[:space:]]*$/ { next }
		{ n = (name != "" && name !~ /^Generated/) ? name : $1
		  print $1 "\t" n "\t" $2 "\t" ($7 ? $7 : 443) "\t" ($6 ? $6 : u) "\t" $3 "\t" $4 "\t" $5; name = "" }'
}
# nodes-custom.conf without node $1 (and its name line).
without() {
	[ -f "$CUSTOM" ] || return 0
	awk -v c="$1" '/^[[:space:]]*#/ { held = held $0 "\n"; next }
		/^[[:space:]]*$/ { next }
		{ if ($1 != c) printf "%s%s\n", held, $0; held = "" }' "$CUSTOM"
}
is_custom() { entries "$CUSTOM" | awk -F "$TAB" -v c="$1" '$1 == c { f = 1 } END { exit !f }'; }
NL='
'
check() {
	case "$2" in *"$NL"*) echo "Bad $1"; exit 1 ;; esac
	echo "$2" | grep -qE "$3" || { echo "Bad $1: '$2'"; exit 1; }
}
reapply() { if [ "$(cat "$CUR" 2>/dev/null)" = "$1" ]; then gru-node apply; fi; }

set_node() {
	code="$1"; host="$3"; port="$4"; uuid="$5"; sni="$6"; pbk="$7"; sid="${8:--}"
	name="$(printf '%s' "$2" | tr -d '\000-\037')"
	check address "$host" '^[A-Za-z0-9.-]+$'
	check port "$port" '^[0-9]{1,5}$'
	check uuid "$uuid" '^[A-Za-z0-9-]{1,64}$'
	check SNI "$sni" '^[A-Za-z0-9.-]+$'
	check "public key (pbk)" "$pbk" '^[A-Za-z0-9_-]{43}$'
	check "short id" "$sid" '^(-|[0-9a-fA-F]{1,16})$'
	if [ "$code" = new ]; then
		i=1; while entries "$NODES" "$CUSTOM" | cut -f1 | grep -qx "my$i"; do i=$((i + 1)); done
		code="my$i"
	else
		is_custom "$code" || { echo "Not an own node: $code (copy it first)"; exit 1; }
	fi
	umask 077
	{ without "$code"; printf '# %s\n%s  %s  %s  %s  %s  %s  %s\n' "${name:-$host}" "$code" "$host" "$sni" "$pbk" "$sid" "$uuid" "$port"; } > "$CUSTOM.new"
	mv "$CUSTOM.new" "$CUSTOM"
	echo "Saved: $code (${name:-$host})"
	reapply "$code"
}

. "$ENV"
case "$1" in
	list)
		entries "$CUSTOM" | cut -f1,2
		;;
	show)
		entries "$NODES" "$CUSTOM" | awk -F "$TAB" -v c="$2" '$1 == c' | head -n1
		;;
	link)
		r="$(printf '%s\n' "$2" | tr -d '\r' | LC_ALL=C awk -f "$PARSER")"
		[ -n "$r" ] || { echo "Not a vless:// link"; exit 1; }
		IFS="$TAB" read -r st host port uuid sni pbk sid fl name <<EOF
$r
EOF
		[ "$st" = ok ] || { echo "Unsupported link ($st): only TCP + REALITY (+ xtls-rprx-vision)"; exit 1; }
		set_node new "$(printf '%b' "$name")" "$host" "$port" "$uuid" "$sni" "$pbk" "$sid"
		;;
	set)
		shift; set_node "$@"
		;;
	del)
		is_custom "$2" || { echo "Not an own node: $2"; exit 1; }
		without "$2" > "$CUSTOM.new"; mv "$CUSTOM.new" "$CUSTOM"
		echo "Deleted: $2"
		if [ "$(cat "$CUR" 2>/dev/null)" = "$2" ]; then
			first="$(gru-node codes | head -n1)"
			echo "It was the current server, switching to $first"
			gru-node "$first"
		fi
		;;
	*)
		sed -n '4,8s/^# \{0,1\}//p' "$0"; exit 1
		;;
esac

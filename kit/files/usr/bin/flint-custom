#!/bin/sh
# Own VLESS REALITY nodes, kept in nodes-custom.conf apart from the subscription list
# (flint-sub-update never touches them). Same format as nodes.conf.
# Usage: flint-custom list                  code<TAB>name of own nodes
#        flint-custom show <code>           code name address port uuid sni pbk sid net service (TAB-separated, any node)
#        flint-custom link <vless://...>    add a node from a share link
#        flint-custom set <code|new> <name> <address> <port> <uuid> <sni> <pbk> [sid] [tcp|grpc] [service]
#        flint-custom del <code>
set -e
. /usr/share/flint/lib.sh
ENV=/etc/xray/flint.env
PARSER=/usr/share/flint/vless.awk

# nodes-custom.conf without node $1 (and its name line).
without() {
	[ -f "$CUSTOM" ] || return 0
	awk -v c="$1" '/^[[:space:]]*#/ { held = held $0 "\n"; next }
		/^[[:space:]]*$/ { next }
		{ if ($1 != c) printf "%s%s\n", held, $0; held = "" }' "$CUSTOM"
}
is_custom() { nodes_tsv "$CUSTOM" | awk -F "$TAB" -v c="$1" '$1 == c { f = 1 } END { exit !f }'; }
NL='
'
check() {
	case "$2" in *"$NL"*) echo "Bad $1"; exit 1 ;; esac
	echo "$2" | grep -qE "$3" || { echo "Bad $1: '$2'"; exit 1; }
}
# Also the first server on a router that had none: it becomes the current one.
reapply() {
	cur="$(flint-node current)"
	if [ -z "$cur" ] || [ "$cur" = "$1" ]; then flint-node apply; fi
}

set_node() {
	code="$1"; host="$3"; port="$4"; uuid="$5"; sni="$6"; pbk="$7"; sid="${8:--}"; net="${9:-tcp}"; svc="${10:--}"
	name="$(printf '%s' "$2" | tr -d '\000-\037')"
	check address "$host" '^[A-Za-z0-9.-]+$'
	check port "$port" '^[0-9]{1,5}$'
	check uuid "$uuid" '^[A-Za-z0-9-]{1,64}$'
	check SNI "$sni" '^[A-Za-z0-9.-]+$'
	check "public key (pbk)" "$pbk" '^[A-Za-z0-9_-]{43}$'
	check "short id" "$sid" '^(-|[0-9a-fA-F]{1,16})$'
	check transport "$net" '^(tcp|grpc)$'
	check "gRPC service" "$svc" '^(-|[A-Za-z0-9._/-]{1,64})$'
	if [ "$code" = new ]; then
		i=1; while nodes_tsv | cut -f1 | grep -qx "my$i"; do i=$((i + 1)); done
		code="my$i"
	else
		is_custom "$code" || { echo "Not an own node: $code (copy it first)"; exit 1; }
	fi
	umask 077
	{ without "$code"; printf '# %s\n%s  %s  %s  %s  %s  %s  %s  %s  %s\n' "${name:-$host}" "$code" "$host" "$sni" "$pbk" "$sid" "$uuid" "$port" "$net" "$svc"; } > "$CUSTOM.new"
	mv "$CUSTOM.new" "$CUSTOM"
	echo "Saved: $code (${name:-$host})"
	reapply "$code"
}

. "$ENV"
case "$1" in
	list)
		nodes_tsv "$CUSTOM" | cut -f1,2
		;;
	show)
		nodes_tsv | awk -F "$TAB" -v c="$2" '$1 == c' | cut -f1-10 | head -n1
		;;
	link)
		r="$(printf '%s\n' "$2" | tr -d '\r' | LC_ALL=C awk -f "$PARSER")"
		[ -n "$r" ] || { echo "Not a vless:// link"; exit 1; }
		IFS="$TAB" read -r st host port uuid sni pbk sid fl net svc name <<EOF
$r
EOF
		[ "$st" = ok ] || { echo "Unsupported link ($st): only REALITY over TCP (xtls-rprx-vision) or gRPC"; exit 1; }
		set_node new "$(printf '%b' "$name")" "$host" "$port" "$uuid" "$sni" "$pbk" "$sid" "$net" "$svc"
		;;
	set)
		shift; set_node "$@"
		;;
	del)
		is_custom "$2" || { echo "Not an own node: $2"; exit 1; }
		without "$2" > "$CUSTOM.new"; mv "$CUSTOM.new" "$CUSTOM"
		echo "Deleted: $2"
		if [ "$(flint-node current)" = "$2" ]; then flint-node apply; fi
		;;
	*)
		sed -n '4,8s/^# \{0,1\}//p' "$0"; exit 1
		;;
esac

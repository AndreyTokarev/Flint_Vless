#!/bin/sh
# Rebuild /etc/xray/nodes.conf from the provider subscription (SUB_URL in /etc/xray/flint.env)
# and re-apply the current node. Router-side twin of tools/sub2nodes.py: keeps REALITY links
# over TCP (+ xtls-rprx-vision) or gRPC; the code comes from the flag in the name.
# Own nodes in nodes-custom.conf (see flint-custom) are left alone.
# Usage: flint-sub-update                 update now
#        flint-sub-update interval [off|30m|1h|3h|6h|12h|24h]   show / set the auto-update schedule
ENV=/etc/xray/flint.env
NODES=/etc/xray/nodes.conf
CUSTOM=/etc/xray/nodes-custom.conf
CUR=/etc/xray/current-node
STATUS=/etc/xray/sub-checked
INTERVAL=/etc/xray/sub-interval
CRON=/etc/crontabs/root
TMP=/tmp/flint-sub
. "$ENV"
# Message language: FLINT_LANG from the panel, else UI_LANG from flint.env, else Russian.
t() { if [ "${FLINT_LANG:-${UI_LANG:-ru}}" = en ]; then echo "$2"; else echo "$1"; fi; }

if [ "$1" = interval ]; then
	[ -n "$2" ] || { cat "$INTERVAL" 2>/dev/null || echo 24h; exit 0; }
	case "$2" in
		off) line="" ;;
		30m) line="*/30 * * * *" ;;
		1h) line="5 * * * *" ;;
		3h|6h|12h) line="5 */${2%h} * * *" ;;
		24h) line="15 5 * * *" ;;
		*) echo "Usage: flint-sub-update interval [off|30m|1h|3h|6h|12h|24h]"; exit 1 ;;
	esac
	[ -n "$SUB_URL" ] || line=""
	touch "$CRON"
	sed -i '/flint-sub-update/d' "$CRON"
	[ -z "$line" ] || echo "$line /usr/bin/flint-sub-update >/tmp/flint-sub-update.log 2>&1" >> "$CRON"
	echo "$2" > "$INTERVAL"
	/etc/init.d/cron restart >/dev/null 2>&1 || true
	t "Автообновление серверов: $2" "Server list auto-update: $2"
	exit 0
fi

status() { echo "$(date '+%Y-%m-%d %H:%M') — $1" > "$STATUS"; echo "$1"; }
[ -n "$SUB_URL" ] || { echo "SUB_URL is not set in $ENV"; exit 1; }
# Cron every 30 min plus the panel button must not run two updates at once.
find /tmp -maxdepth 1 -name flint-sub.lock -mmin +10 -exec rm -rf {} + 2>/dev/null
mkdir /tmp/flint-sub.lock 2>/dev/null || { t "Обновление уже идёт" "An update is already running"; exit 1; }
trap 'rm -rf /tmp/flint-sub.lock "$TMP"' EXIT

rm -rf "$TMP"; mkdir -p "$TMP"
fetch() { curl -fsSL -m 25 -A "Happ/1.0" "$@" -o "$TMP/raw" "$SUB_URL"; }
# Router traffic is not redirected into Xray, so try directly first; through the tunnel as a fallback.
fetch || { sleep 3; fetch; } || fetch -x http://127.0.0.1:1087 || { status "$(t "ошибка: подписка не скачалась" "error: the subscription could not be downloaded")"; exit 1; }

if grep -q 'vless://' "$TMP/raw"; then
	cp "$TMP/raw" "$TMP/links"
else
	tr -d ' \r\n\t' < "$TMP/raw" | LC_ALL=C awk '
		BEGIN { a = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
			for (i = 0; i < 64; i++) v[substr(a, i + 1, 1)] = i
			v["-"] = 62; v["_"] = 63 }
		{ s = s $0 }
		END { bits = 0; n = 0
			for (i = 1; i <= length(s); i++) {
				c = substr(s, i, 1); if (!(c in v)) continue
				bits = bits * 64 + v[c]; n += 6
				if (n >= 8) { n -= 8; b = int(bits / 2 ^ n); bits -= b * 2 ^ n; printf "%c", b }
			} }' > "$TMP/links"
fi

# gRPC nodes are skipped unless SUB_GRPC=1: with Xray 1.8.7 the provider's gRPC REALITY servers fail the handshake.
grep '^vless://' "$TMP/links" | tr -d '\r' | LC_ALL=C awk -f /usr/share/flint/vless.awk | awk -F '\t' -v grpc="${SUB_GRPC:-0}" '
	$1 != "ok" || ($9 == "grpc" && grpc != 1) { next }
	{
		base = $8; if (base == "-") { base = $2; sub(/[.-].*/, "", base) }
		code = base; k = 2; while (code in used) code = base k++
		used[code] = 1
		print code "\t" $2 "\t" $5 "\t" $6 "\t" $7 "\t" $4 "\t" $3 "\t" $9 "\t" $10 "\t" $11
	}' > "$TMP/nodes.tsv"

count="$(wc -l < "$TMP/nodes.tsv")"
[ "$count" -gt 0 ] || { status "$(t "ошибка: в подписке нет поддерживаемых серверов, список не изменён" "error: no supported servers in the subscription, list unchanged")"; exit 1; }

{
	echo "# Generated by flint-sub-update. Columns: code address sni pbk sid uuid port net service"
	while IFS="$(printf '\t')" read -r code host sni pbk sid uuid port net svc name; do
		printf '# %b\n' "$name"
		echo "$code  $host  $sni  $pbk  $sid  $uuid  $port  $net  $svc"
	done < "$TMP/nodes.tsv"
} > "$TMP/nodes.conf"

# The provider hands out a random SNI from its pool on every request: ignore SNI-only changes.
strip_sni() { grep -v -E '^[[:space:]]*(#|$)' "$1" | awk '{ $3 = ""; print }'; }
if [ -f "$NODES" ] && [ "$(strip_sni "$TMP/nodes.conf")" = "$(strip_sni "$NODES")" ]; then
	status "$(t "без изменений ($count серверов)" "no changes ($count servers)")"
	exit 0
fi
cp "$NODES" "$NODES.bak" 2>/dev/null
(umask 077; cp "$TMP/nodes.conf" "$NODES")
status "$(t "список обновлён: $count серверов" "list updated: $count servers")"

cur="$(cat "$CUR" 2>/dev/null)"
if ! cat "$NODES" "$CUSTOM" 2>/dev/null | awk -v c="$cur" '$1 == c { f = 1 } END { exit !f }'; then
	cur="$(grep -v -E '^[[:space:]]*(#|$)' "$NODES" | awk 'NR == 1 {print $1}')"
	t "Текущего сервера больше нет, переключаюсь на $cur" "The current server is gone, switching to $cur"
fi
flint-node "$cur"

#!/bin/sh
# Rebuild /etc/xray/nodes.conf from the provider subscription (SUB_URL in /etc/xray/gru.env)
# and re-apply the current node. Router-side twin of tools/sub2nodes.py: keeps TCP + REALITY
# (+ xtls-rprx-vision) links with a domain address; the code comes from the flag in the name.
# Own nodes in nodes-custom.conf (see gru-custom) are left alone.
ENV=/etc/xray/gru.env
NODES=/etc/xray/nodes.conf
CUSTOM=/etc/xray/nodes-custom.conf
CUR=/etc/xray/current-node
TMP=/tmp/gru-sub
. "$ENV"
[ -n "$SUB_URL" ] || { echo "SUB_URL is not set in $ENV"; exit 1; }

rm -rf "$TMP"; mkdir -p "$TMP"
fetch() { curl -fsSL -m 30 -A "Happ/1.0" "$@" -o "$TMP/raw" "$SUB_URL"; }
fetch || fetch -x http://127.0.0.1:1087 || { echo "Subscription download failed"; exit 1; }

if grep -q 'vless://' "$TMP/raw"; then
	cp "$TMP/raw" "$TMP/links"
else
	tr -d ' \r\n\t' < "$TMP/raw" | LC_ALL=C awk '
		BEGIN { a = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
			for (i = 0; i < 64; i++) v[substr(a, i + 1, 1)] = i
			v["-"] = 62; v["_"] = 63 }
		{ s = s $0 }
		END { bits = 0; n = 0
			for (i = 1; i <= length(s); i++) {
				c = substr(s, i, 1); if (!(c in v)) continue
				bits = bits * 64 + v[c]; n += 6
				if (n >= 8) { n -= 8; b = int(bits / 2 ^ n); bits -= b * 2 ^ n; printf "%c", b }
			} }' > "$TMP/links"
fi

grep '^vless://' "$TMP/links" | tr -d '\r' | LC_ALL=C awk -f /usr/share/gru/vless.awk | awk -F '\t' '
	$1 != "ok" || $2 ~ /^[0-9.]+$/ { next }
	{
		base = $8; if (base == "-") { base = $2; sub(/[.-].*/, "", base) }
		code = base; k = 2; while (code in used) code = base k++
		used[code] = 1
		print code "\t" $2 "\t" $5 "\t" $6 "\t" $7 "\t" $4 "\t" $3 "\t" $9
	}' > "$TMP/nodes.tsv"

count="$(wc -l < "$TMP/nodes.tsv")"
[ "$count" -gt 0 ] || { echo "No TCP+REALITY nodes in the subscription, nodes.conf unchanged"; rm -rf "$TMP"; exit 1; }

{
	echo "# Generated by gru-sub-update. Columns: code address sni pbk sid uuid port"
	while IFS="$(printf '\t')" read -r code host sni pbk sid uuid port name; do
		printf '# %b\n' "$name"
		echo "$code  $host  $sni  $pbk  $sid  $uuid  $port"
	done < "$TMP/nodes.tsv"
} > "$TMP/nodes.conf"

date '+%Y-%m-%d %H:%M' > /etc/xray/sub-checked
# The provider hands out a random SNI from its pool on every request: ignore SNI-only changes.
strip_sni() { grep -v -E '^[[:space:]]*(#|$)' "$1" | awk '{ $3 = ""; print }'; }
if [ -f "$NODES" ] && [ "$(strip_sni "$TMP/nodes.conf")" = "$(strip_sni "$NODES")" ]; then
	echo "Server list unchanged ($count servers)"
	rm -rf "$TMP"; exit 0
fi
cp "$NODES" "$NODES.bak" 2>/dev/null
(umask 077; cp "$TMP/nodes.conf" "$NODES")
rm -rf "$TMP"
echo "Server list updated: $count servers"

cur="$(cat "$CUR" 2>/dev/null)"
if ! cat "$NODES" "$CUSTOM" 2>/dev/null | awk -v c="$cur" '$1 == c { f = 1 } END { exit !f }'; then
	cur="$(grep -v -E '^[[:space:]]*(#|$)' "$NODES" | awk 'NR == 1 {print $1}')"
	echo "Current server is gone, switching to $cur"
fi
gru-node "$cur"

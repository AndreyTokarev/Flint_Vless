#!/bin/sh
# DNS ad blocking with AdGuard Home (the binary ships with GL firmware 4.x).
# LAN DNS is redirected by the FLINT_DNS firewall chain: to AdGuard Home (:5054) when blocking is on,
# else to dnsmasq (:53). AdGuard Home forwards to dnsmasq, so local names and DoH keep working.
# Excluded devices (by MAC) always go straight to dnsmasq. Our own AdGuard Home instance, separate
# from GL's; lists, rules and exclusions live in /etc/xray, so they survive redeploys and go into backups.
# Usage: flint-adblock [state]                    print on|off
#        flint-adblock on|off
#        flint-adblock list | list add <url> [name] | list del <url>
#        flint-adblock rule | rule add block|allow <domain, link or AdGuard rule> | rule del <rule>
#        flint-adblock blocked                         recently blocked domains: domain, device (not yet allowed)
#        flint-adblock exclude | exclude add <mac> [name] | exclude del <mac>
#        flint-adblock devices                         LAN devices: mac, ip, name
#        flint-adblock interval [off|1|12|24|72|168]   list auto-update period, hours
#        flint-adblock refresh                         update the lists now
#        flint-adblock stats                           "<queries> <blocked>" over the last 24 hours
#        flint-adblock check                           cron: restart AdGuard Home or let DNS bypass it
#        flint-adblock fw [bypass]                     rebuild the FLINT_DNS chain (firewall.user)
#        flint-adblock config                          write the AdGuard Home config (init script)
STATE=/etc/xray/adblock
LISTS=/etc/xray/adblock-lists
RULES=/etc/xray/adblock-rules
EXCLUDE=/etc/xray/adblock-exclude
INTERVAL=/etc/xray/adblock-interval
DIR=/etc/flint-adguard
BIN=/usr/bin/AdGuardHome
API=http://127.0.0.1:3054/control
DNS_PORT=5054
# Answered by AdGuard Home itself, without the upstream: tells "AdGuard is down" from "internet is down".
CHECK_HOST=adblock-check.flint
DEFAULT_LIST="https://adguardteam.github.io/HostlistsRegistry/assets/filter_1.txt	AdGuard DNS filter"
. /usr/share/flint/lib.sh
. /etc/xray/flint.env 2>/dev/null || true
state() { cat "$STATE" 2>/dev/null || echo off; }
interval() { cat "$INTERVAL" 2>/dev/null || echo 24; }
lists() { [ -f "$LISTS" ] || printf '%s\n' "$DEFAULT_LIST" > "$LISTS"; cat "$LISTS"; }
rules() { [ -f "$RULES" ] && grep -v '^$' "$RULES"; }
excluded() { [ -f "$EXCLUDE" ] && grep -v '^$' "$EXCLUDE"; }
running() { curl -s -m 3 -o /dev/null "$API/status"; }
answers() { nslookup "$CHECK_HOST" "127.0.0.1:$DNS_PORT" >/dev/null 2>&1; }
yaml() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"; }
json() { printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"; }
# post <endpoint> <json> [timeout]: prints the HTTP code, the body goes to $OUT.
OUT=/tmp/flint-adblock.out
post() { curl -s -m "${3:-30}" -o "$OUT" -w '%{http_code}' -X POST -H 'Content-Type: application/json' -d "$2" "$API/$1"; }
# Stable per URL, so the downloaded copy in $DIR/data/filters/<id>.txt is reused after a restart.
list_id() { printf '%d' "0x$(printf '%s' "$1" | md5sum | cut -c1-7)"; }

# FLINT_DNS: excluded MACs -> dnsmasq, everyone else -> AdGuard Home (or dnsmasq when off / bypassed).
fw() {
	iptables -t nat -N FLINT_DNS 2>/dev/null || iptables -t nat -F FLINT_DNS
	port=53
	if [ "$(state)" = on ] && [ -x "$BIN" ] && [ "$1" != bypass ]; then
		excluded | cut -f1 | while read -r m; do
			for p in udp tcp; do iptables -t nat -A FLINT_DNS -p "$p" -m mac --mac-source "$m" -j REDIRECT --to-ports 53; done
		done
		port=$DNS_PORT
	fi
	for p in udp tcp; do iptables -t nat -A FLINT_DNS -p "$p" -j REDIRECT --to-ports "$port"; done
}

write_config() {
	mkdir -p "$DIR"
	iv="$(interval)"; [ "$iv" = off ] && iv=0
	{
		echo "bind_host: 127.0.0.1"
		echo "bind_port: 3054"
		echo "users: []"
		echo "dns:"
		echo "  bind_hosts:"
		echo "  - 127.0.0.1"
		echo "  - $(lan_ip)"
		echo "  port: $DNS_PORT"
		echo "  upstream_dns:"
		echo "  - 127.0.0.1:53"
		echo "  bootstrap_dns:"
		echo "  - 127.0.0.1:53"
		echo "  ratelimit: 0"
		# dnsmasq behind it caches already; AdGuard's own cache would keep answering for domains blocked later.
		echo "  cache_size: 0"
		echo "  protection_enabled: true"
		echo "  filtering_enabled: true"
		echo "  filters_update_interval: $iv"
		# The last queries stay in memory only, for "flint-adblock blocked"; nothing is written to flash.
		echo "  querylog_enabled: true"
		echo "  querylog_file_enabled: false"
		echo "  querylog_size_memory: 1000"
		echo "  statistics_interval: 1"
		echo "filters:"
		lists | while IFS="$TAB" read -r url name; do
			[ -n "$url" ] || continue
			echo "- enabled: true"
			echo "  url: $(yaml "$url")"
			echo "  name: $(yaml "${name:-$url}")"
			echo "  id: $(list_id "$url")"
		done
		echo "whitelist_filters: []"
		echo "user_rules:"
		echo "- '||$CHECK_HOST^'"
		rules | while IFS= read -r r; do echo "- $(yaml "$r")"; done
		echo "schema_version: 14"
	} > "$DIR/config.yaml"
}

push_rules() {
	running || return 0
	body="{\"rules\":[\"||$CHECK_HOST^\""
	while IFS= read -r r; do [ -n "$r" ] && body="$body,$(json "$r")"; done <<EOF
$(rules)
EOF
	post filtering/set_rules "$body]}" >/dev/null
}

# "https://www.Ads.example.com/x" -> ads.example.com
normalize() {
	echo "$1" | tr 'A-Z' 'a-z' | sed -e 's|^[a-z]*://||' -e 's|[/?#].*$||' -e 's|^www\.||' -e 's|:[0-9]*$||' |
		grep -E '^([a-z0-9-]+\.)+[a-z0-9-]{2,}$'
}

APPLY="$(t "применится через несколько секунд" "applies in a few seconds")"

case "$1" in
	""|state) state ;;
	on)
		[ -x "$BIN" ] || fail "$(t "AdGuard Home не найден ($BIN): нужна прошивка GL 4.x или пакет adguardhome" \
			"AdGuard Home not found ($BIN): needs GL firmware 4.x or the adguardhome package")"
		echo on > "$STATE"
		/etc/init.d/flint-adblock enable
		/etc/init.d/flint-adblock restart >/dev/null 2>&1
		n=0
		until answers; do
			n=$((n + 1))
			if [ "$n" -gt 20 ]; then
				echo off > "$STATE"
				/etc/init.d/flint-adblock stop >/dev/null 2>&1
				fw
				fail "$(t "AdGuard Home не ответил — блокировка выключена, DNS работает как раньше" \
					"AdGuard Home did not answer — ad blocking is off, DNS works as before")"
			fi
			sleep 1
		done
		fw
		t "Блокировка рекламы включена" "Ad blocking is on"
		;;
	off)
		echo off > "$STATE"
		fw
		/etc/init.d/flint-adblock stop >/dev/null 2>&1
		/etc/init.d/flint-adblock disable
		t "Блокировка рекламы выключена" "Ad blocking is off"
		;;
	list)
		case "$2" in
			"")
				st=""
				if running; then
					st="$(curl -s -m 5 "$API/filtering/status" | jsonfilter -e '@.filters[*]' | while read -r f; do
						printf '%s\t%s\t%s\n' "$(jsonfilter -s "$f" -e '@.url')" "$(jsonfilter -s "$f" -e '@.rules_count')" \
							"$(jsonfilter -s "$f" -e '@.last_updated' | sed -n 's/^\([0-9-]*\)T\([0-9:]*\).*/\1 \2/p')"
					done)"
				fi
				lists | while IFS="$TAB" read -r url name; do
					[ -n "$url" ] || continue
					line="$(printf '%s\n' "$st" | awk -F '\t' -v u="$url" '$1 == u' | head -n1)"
					rc="-"; up="-"
					if [ -n "$line" ]; then
						rc="$(echo "$line" | cut -f2)"
						# AdGuard Home reports UTC.
						s="$(date -u -d "$(echo "$line" | cut -f3)" +%s 2>/dev/null)" && up="$(date -d "@$s" '+%Y-%m-%d %H:%M')"
					fi
					printf '%s\t%s\t%s\t%s\n' "$url" "${name:-$url}" "$rc" "$up"
				done
				;;
			add)
				url="$3"
				echo "$url" | grep -qE '^https?://[^[:space:]]+$' || fail "$(t "Это не ссылка на список: $url" "Not a list URL: $url")"
				lists | cut -f1 | grep -qxF "$url" && fail "$(t "Этот список уже добавлен" "This list is already added")"
				name="$(printf '%s' "$4" | tr -d '\t\r\n' | cut -c1-60)"
				[ -n "$name" ] || name="$(echo "$url" | sed -E 's#^https?://##; s#/.*/#/#')"
				if running; then
					code="$(post filtering/add_url "{\"name\":$(json "$name"),\"url\":$(json "$url"),\"whitelist\":false}" 120)"
					[ "$code" = 200 ] || fail "$(t "Список не скачался" "The list could not be downloaded"): $(head -c 300 "$OUT")"
				fi
				printf '%s\t%s\n' "$url" "$name" >> "$LISTS"
				t "Список добавлен: $name" "List added: $name"
				;;
			del)
				lists | cut -f1 | grep -qxF "$3" || fail "$(t "Нет такого списка" "No such list")"
				lists | awk -F '\t' -v u="$3" '$1 != u' > "$LISTS.new"
				mv "$LISTS.new" "$LISTS"
				running && post filtering/remove_url "{\"url\":$(json "$3"),\"whitelist\":false}" >/dev/null
				t "Список удалён" "List removed"
				;;
			*) fail "flint-adblock list | list add <url> [name] | list del <url>" ;;
		esac
		;;
	rule)
		case "$2" in
			"") rules ;;
			add)
				[ "$3" = block ] || [ "$3" = allow ] || fail "flint-adblock rule add block|allow <rule>"
				r="$(printf '%s' "$4" | tr -d '\r\n\t' | sed 's/^ *//; s/ *$//')"
				case "$r" in
					""|"!"*|"#"*) fail "$(t "Это не домен и не правило: $r" "Not a domain or a rule: $r")" ;;
					"@@"*|"|"*|"/"*|*"^"*|*"*"*|*'$'*) rule="$r" ;;
					*)
						d="$(normalize "$r")"
						[ -n "$d" ] || fail "$(t "Это не домен и не правило: $r" "Not a domain or a rule: $r")"
						rule="||$d^" ;;
				esac
				if [ "$3" = allow ]; then case "$rule" in "@@"*) ;; *) rule="@@$rule" ;; esac; fi
				rules | grep -qxF -- "$rule" && fail "$(t "Такое правило уже есть" "This rule already exists")"
				echo "$rule" >> "$RULES"
				push_rules
				t "Правило добавлено: $rule ($APPLY)" "Rule added: $rule ($APPLY)"
				;;
			del)
				rules | grep -qxF -- "$3" || fail "$(t "Нет такого правила" "No such rule")"
				rules | grep -vxF -- "$3" > "$RULES.new"
				mv "$RULES.new" "$RULES"
				push_rules
				t "Правило удалено ($APPLY)" "Rule removed ($APPLY)"
				;;
			*) fail "flint-adblock rule | rule add block|allow <rule> | rule del <rule>" ;;
		esac
		;;
	exclude)
		case "$2" in
			"") excluded ;;
			add)
				m="$(mac "$3")"
				[ -n "$m" ] || fail "$(t "Это не MAC-адрес: $3" "Not a MAC address: $3")"
				excluded | cut -f1 | grep -qxF "$m" && fail "$(t "Это устройство уже в исключениях" "This device is already excluded")"
				name="$(printf '%s' "$4" | tr -d '\t\r\n' | cut -c1-40)"
				[ -n "$name" ] || name="$(devices | awk -F '\t' -v m="$m" '$1 == m { print ($3 != "" ? $3 : $2) }' | head -n1)"
				printf '%s\t%s\n' "$m" "${name:-$m}" >> "$EXCLUDE"
				fw
				t "Без блокировки: ${name:-$m}" "Not blocked: ${name:-$m}"
				;;
			del)
				m="$(mac "$3")"
				excluded | cut -f1 | grep -qxF "$m" || fail "$(t "Нет такого устройства" "No such device")"
				excluded | awk -F '\t' -v m="$m" '$1 != m' > "$EXCLUDE.new"
				mv "$EXCLUDE.new" "$EXCLUDE"
				fw
				t "Устройство снова с блокировкой" "The device is blocked again"
				;;
			*) fail "flint-adblock exclude | exclude add <mac> [name] | exclude del <mac>" ;;
		esac
		;;
	blocked)
		running || exit 0
		curl -s -m 5 -o "$OUT" "$API/querylog?limit=300&response_status=blocked" || exit 0
		jsonfilter -i "$OUT" -e '@.data[*].client' > "$OUT.client"
		rules | sed -n 's/^@@||\([a-z0-9.-]*\)^$/\1/p' > "$OUT.allowed"
		devices > "$OUT.devices"
		# Newest first, one line per domain.
		jsonfilter -i "$OUT" -e '@.data[*].question.name' |
			awk -F '\t' -v skip="$CHECK_HOST" '
				# An allow rule also covers subdomains.
				function allowed(d,  i) { while (1) { if (d in ok) return 1; if (!(i = index(d, "."))) return 0; d = substr(d, i + 1) } }
				FILENAME == ARGV[1] { name[$2] = ($3 != "" ? $3 : $2); next }
				FILENAME == ARGV[2] { ok[$0] = 1; next }
				FILENAME == ARGV[3] { client[FNR] = $0; next }
				{ d = tolower($0); sub(/\.$/, "", d) }
				d == skip || allowed(d) || seen[d]++ { next }
				{ c = client[FNR]; print d "\t" (c in name ? name[c] : c); if (++n == 30) exit }
			' "$OUT.devices" "$OUT.allowed" "$OUT.client" -
		rm -f "$OUT.client" "$OUT.allowed" "$OUT.devices"
		;;
	devices) devices ;;
	interval)
		[ -n "$2" ] || { interval; exit 0; }
		case "$2" in off|1|12|24|72|168) ;; *) fail "flint-adblock interval off|1|12|24|72|168" ;; esac
		echo "$2" > "$INTERVAL"
		iv="$2"; [ "$iv" = off ] && iv=0
		running && post filtering/config "{\"enabled\":true,\"interval\":$iv}" >/dev/null
		if [ "$2" = off ]; then t "Автообновление списков выключено" "List auto-update is off"
		else t "Списки обновляются каждые $2 ч" "Lists update every $2 h"; fi
		;;
	refresh)
		running || fail "$(t "Блокировка выключена — включите её, чтобы обновить списки" "Ad blocking is off — turn it on to update the lists")"
		[ "$(post filtering/refresh '{"whitelist":false}' 180)" = 200 ] ||
			fail "$(t "Не удалось обновить списки" "Could not update the lists"): $(head -c 300 "$OUT")"
		n="$(jsonfilter -i "$OUT" -e '@.updated')"
		t "Списки проверены, обновлено: ${n:-0}" "Lists checked, updated: ${n:-0}"
		;;
	stats)
		running || exit 1
		eval "$(curl -s -m 5 "$API/stats" | jsonfilter -e 'q=@.num_dns_queries' -e 'b=@.num_blocked_filtering')"
		echo "${q:-0} ${b:-0}"
		;;
	check)
		[ "$(state)" = on ] || exit 0
		redirected() { iptables -t nat -S FLINT_DNS 2>/dev/null | grep -q -- "--to-ports $DNS_PORT"; }
		if answers; then redirected || fw; exit 0; fi
		/etc/init.d/flint-adblock restart >/dev/null 2>&1
		sleep 8
		if answers; then redirected || fw; exit 0; fi
		fw bypass
		logger -t flint-adblock "AdGuard Home is not answering, DNS bypasses it until it is back"
		;;
	fw) fw "$2" ;;
	config) write_config ;;
	*) sed -n '7,18s/^# \{0,1\}//p' "$0"; exit 1 ;;
esac

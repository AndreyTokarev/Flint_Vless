#!/bin/sh
# SPDX-FileCopyrightText: 2026 Andrey Tokarev
# SPDX-License-Identifier: LicenseRef-Flint-VPN-Noncommercial-1.0
# Export and import the settings made in the panel: subscriptions, manual and own servers, sites, devices without VPN,
# ad blocking, DNS server, local names, Telegram proxy, modes and intervals. flint.env (PIN, network) is not included,
# so a file fits another Flint.
# File format: a "# Flint VPN settings" first line, then "[<file in /etc/xray>]" sections with every
# content line prefixed by "|". Import replaces all these settings; the previous ones go to $PREV.
# Usage: flint-settings export [dir]        print the settings (from another copy of /etc/xray, e.g. a backup)
#        flint-settings import [file]       load settings from the file (default: stdin) and apply them

# The comment block above the code: every "# Usage:" line up to the first line that is not a comment.
help() {
	awk '/^# Usage:/ { u = 1 } u && /^#/ { sub(/^# ?/, ""); print; next } u { exit }' "$0"
}
. /usr/share/flint/lib.sh
. /etc/xray/flint.env 2>/dev/null || true
# The list of user settings lives in one place, /usr/share/flint/settings-files, and is shared with the
# tests that check it against the backup list (kit/state-files).
ENTRIES="$(grep -v -E '^[[:space:]]*(#|$)' /usr/share/flint/settings-files 2>/dev/null | tr '\n' ' ')"
[ -n "${ENTRIES% }" ] || fail "flint-settings: /usr/share/flint/settings-files is missing or empty"
TMP=/tmp/flint-import
PREV=/tmp/flint-settings-prev.txt

section() { echo "[$1]"; sed 's/^/|/' "$2"; }
export_settings() {
	d="${1:-/etc/xray}"
	[ -d "$d" ] || fail "No $d"
	echo "# Flint VPN settings $(cat /usr/share/flint/version 2>/dev/null), $(date '+%Y-%m-%d %H:%M'). Subscription links and servers inside: keep it private."
	for e in $ENTRIES; do
		if [ "$e" = nodes.d ]; then
			for f in "$d/nodes.d"/*.conf; do if [ -f "$f" ]; then section "nodes.d/${f##*/}" "$f"; fi; done
		elif [ -f "$d/$e" ]; then
			section "$e" "$d/$e"
		fi
	done
}

case "$1" in
	export) export_settings "$2" ;;
	import)
		rm -rf "$TMP"; mkdir -p "$TMP/x/nodes.d" || fail "Cannot create $TMP"
		if [ -n "$2" ]; then tr -d '\r' < "$2"; else tr -d '\r'; fi > "$TMP/in"
		trap 'rm -rf "$TMP"' EXIT
		head -n1 "$TMP/in" | grep -q '^# Flint VPN settings' ||
			fail "$(t "Это не файл настроек Flint VPN" "This is not a Flint VPN settings file")"
		# Sections are created (also empty ones); an unknown name stops the import before anything changes.
		bad="$(awk -v dir="$TMP/x" -v ok=" $(echo $ENTRIES) " '
			/^\[.*\]$/ {
				n = substr($0, 2, length($0) - 2)
				if ((n != "nodes.d" && index(ok, " " n " ")) || n ~ /^nodes\.d\/[A-Za-z0-9_-]+\.conf$/) { f = dir "/" n; printf "" > f; next }
				print n; exit
			}
			/^\|/ && f != "" { print substr($0, 2) > f }
		' "$TMP/in" 2>&1)"
		[ -z "$bad" ] || fail "$(t "Неизвестный раздел в файле: $bad" "Unknown section in the file: $bad")"
		[ -n "$(find "$TMP/x" -type f)" ] || fail "$(t "В файле нет настроек" "The file has no settings")"
		export_settings > "$PREV"
		for e in $ENTRIES; do rm -rf "/etc/xray/$e"; done
		mkdir -p "$NODES_D"
		(umask 077; cp -R "$TMP/x/." /etc/xray/) || fail "$(t "Не удалось записать настройки" "Cannot write the settings")"
		flint-sub-update interval "$(flint-sub-update interval)" >/dev/null
		# Subscriptions without their server files: fetch them now.
		[ -n "$(flint-node codes)" ] || flint-sub-update >/dev/null 2>&1
		flint-dns apply >/dev/null 2>&1
		flint-dns hosts apply
		flint-node apply >/dev/null 2>&1
		sh /etc/firewall.user >/dev/null 2>&1
		if [ "$(flint-adblock state)" = on ]; then flint-adblock on >/dev/null 2>&1; else flint-adblock off >/dev/null 2>&1; fi
		if [ "$(flint-tg state)" = on ]; then flint-tg on >/dev/null 2>&1; else flint-tg off >/dev/null 2>&1; fi
		flint-tg remote "$(flint-tg remote)" >/dev/null 2>&1
		subs="$(grep -c . "$SUBS" 2>/dev/null)"; nodes="$(flint-node codes | grep -c .)"
		t "Настройки загружены: подписок ${subs:-0}, серверов $nodes. Прежние настройки — в $PREV до перезагрузки." \
			"Settings loaded: ${subs:-0} subscriptions, $nodes servers. The previous settings are in $PREV until a reboot."
		;;
	*) help; exit 1 ;;
esac

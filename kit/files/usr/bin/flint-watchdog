#!/bin/sh
# VPN health check, run by cron every 2 minutes. When the current node stops passing traffic
# while the internet itself works: refresh the subscription (fetched directly, not through the
# dead tunnel) and, if that does not help, switch to the first node that works.
# Usage: flint-watchdog              run a check
#        flint-watchdog on|off       enable / disable (default on)
#        flint-watchdog state        print on|off
STATE=/etc/xray/watchdog
LAST=/etc/xray/watchdog-last
LOCK=/tmp/flint-watchdog.lock
. /etc/xray/flint.env 2>/dev/null
# Message language: FLINT_LANG from the panel, else UI_LANG from flint.env, else Russian.
t() { if [ "${FLINT_LANG:-${UI_LANG:-ru}}" = en ]; then echo "$2"; else echo "$1"; fi; }

case "$1" in
	on|off) echo "$1" > "$STATE"; t "Автопереключение при сбое: $1" "Failover: $1"; exit 0 ;;
	state) cat "$STATE" 2>/dev/null || echo on; exit 0 ;;
	"") ;;
	*) sed -n '5,7s/^# \{0,1\}//p' "$0"; exit 1 ;;
esac
# Ad blocking runs in the DNS path, so it is checked even with failover off.
flint-adblock check >/dev/null 2>&1
[ "$(cat "$STATE" 2>/dev/null || echo on)" = on ] || exit 0
[ "$(flint-node vpn)" = on ] || exit 0
[ -n "$(flint-node codes)" ] || exit 0

tunnel_ok() { [ "$(curl -s -o /dev/null -m 8 -w '%{http_code}' -x http://127.0.0.1:1087 https://www.google.com/generate_204)" = 204 ]; }
online() { curl -s -o /dev/null -m 8 https://ya.ru || curl -s -o /dev/null -m 8 https://www.google.com/generate_204; }
name() { flint-node names | awk -F '\t' -v c="$1" '$1 == c { print $2 }'; }
log() { echo "$(date '+%Y-%m-%d %H:%M') — $1" > "$LAST"; logger -t flint-watchdog "$1"; echo "$1"; }

tunnel_ok && exit 0
sleep 10
tunnel_ok && exit 0
# The internet itself is down: switching nodes would not help.
online || exit 0

find /tmp -maxdepth 1 -name flint-watchdog.lock -mmin +30 -exec rm -rf {} + 2>/dev/null
mkdir "$LOCK" 2>/dev/null || exit 0
trap 'rm -rf "$LOCK"' EXIT

cur="$(cat /etc/xray/current-node 2>/dev/null)"
was="$(name "$cur")"; was="${was:-$cur}"
flint-sub-update >/dev/null 2>&1
sleep 3
if tunnel_ok; then
	log "$(t "сервер «$was» не отвечал, помогло обновление подписки" "server \"$was\" was down, a subscription refresh fixed it")"
	exit 0
fi
for code in $(flint-node codes); do
	[ "$code" = "$cur" ] && continue
	flint-node use "$code" >/dev/null 2>&1 || continue
	sleep 3
	if tunnel_ok; then
		new="$(name "$code")"
		log "$(t "сервер «$was» не отвечал, переключился на «$new»" "server \"$was\" was down, switched to \"$new\"")"
		exit 0
	fi
done
flint-node use "$cur" >/dev/null 2>&1
log "$(t "сервер «$was» не отвечал, рабочих серверов не нашлось" "server \"$was\" was down, no working server found")"

#!/bin/sh
# Switch the Xray VLESS REALITY node and routing mode.
# Usage: gru-node [list|codes|apply|<code>]
#        gru-node routing [ru|global]
#   ru     - Russian sites/IPs go direct, the rest via VPN (needs /usr/share/xray/geo*.dat)
#   global - everything via VPN
set -e
ENV=/etc/xray/gru.env
NODES=/etc/xray/nodes.conf
TEMPLATE=/etc/xray/template.json
CONF=/etc/xray/config.json
CUR=/etc/xray/current-node
MODE_FILE=/etc/xray/routing-mode
GEO=/usr/share/xray

nodes() { grep -v -E '^[[:space:]]*(#|$)' "$NODES"; }
current() { cat "$CUR" 2>/dev/null || nodes | awk 'NR == 1 {print $1}'; }
mode() { cat "$MODE_FILE" 2>/dev/null || echo ru; }

# Provider server names (address + REALITY SNI of every node) routed direct, so a VPN
# client on a Flint device (e.g. Happ) does not get tunnelled into the same provider twice.
provider_domains() {
	nodes | awk '{print $2; print $3}' | grep -v -E '^[0-9.]+$' | sort -u |
		sed 's/.*/"full:&"/' | tr '\n' ',' | sed 's/,$//; s/,/, /g'
}

render() {
	line="$(nodes | awk -v c="$1" '$1 == c' | head -n1)"
	set -- $line
	uuid="${6:-$VLESS_UUID}"
	port="${7:-443}"
	if [ "$RENDER_MODE" = ru ]; then strategy=IPIfNonMatch; else strategy=AsIs; fi
	domains="$(provider_domains)"
	umask 077
	sed -e "s|__UUID__|$uuid|" -e "s|__ADDR__|$2|" -e "s|__PORT__|$port|" -e "s|__SNI__|$3|" \
		-e "s|__PBK__|$4|" -e "s|__SID__|$5|" -e "s|__DOMAIN_STRATEGY__|$strategy|" \
		-e "s|__PROVIDER_DOMAINS__|$domains|" \
		"$TEMPLATE" > "$CONF.new"
	if [ -z "$domains" ]; then
		sed -i '/"domain": \[\]/d' "$CONF.new"
	fi
	if [ "$RENDER_MODE" != ru ]; then
		sed -i -e '/geosite:category-ru/d' -e '/"geoip:ru"/d' "$CONF.new"
	fi
	XRAY_LOCATION_ASSET=$GEO xray run -test -format json -c "$CONF.new" > /tmp/gru-xray-test.log 2>&1
}

apply() {
	code="$1"
	nodes | awk '{print $1}' | grep -qx "$code" || { echo "Unknown: $code"; exit 1; }
	. "$ENV"
	RENDER_MODE="$(mode)"
	if ! render "$code"; then
		if [ "$RENDER_MODE" = ru ]; then
			echo "RU routing unavailable (geo files missing or broken), using global"
			RENDER_MODE=global
			render "$code" || { echo "Config test failed:"; tail -n 3 /tmp/gru-xray-test.log; exit 1; }
		else
			echo "Config test failed:"; tail -n 3 /tmp/gru-xray-test.log; exit 1
		fi
	fi
	mv "$CONF.new" "$CONF"
	echo "$code" > "$CUR"
	/etc/init.d/xray restart
	echo "Node: $code, routing: $RENDER_MODE"
}

cmd="${1:-list}"
case "$cmd" in
	list)
		echo "Current: $(current), routing: $(mode)"
		echo "Codes: $(nodes | awk '{print $1}' | tr '\n' ' ')"
		;;
	codes)
		nodes | awk '{print $1}'
		;;
	names)
		# "code<TAB>name"; the name is the comment line right above the node (see tools/sub2nodes.py).
		awk '/^[[:space:]]*#/ { sub(/^[[:space:]]*#[[:space:]]*/, ""); name = $0; next }
			/^[[:space:]]*$/ { next }
			{ print $1 "\t" ((name != "" && name !~ /^Generated/) ? name : $1); name = "" }' "$NODES"
		;;
	routing)
		[ -n "$2" ] || { mode; exit 0; }
		case "$2" in ru|global) ;; *) echo "Usage: gru-node routing [ru|global]"; exit 1 ;; esac
		echo "$2" > "$MODE_FILE"
		apply "$(current)"
		;;
	apply)
		apply "$(current)"
		;;
	*)
		apply "$cmd"
		sleep 1
		curl -s -m 15 -x http://127.0.0.1:1087 https://ifconfig.me; echo
		;;
esac

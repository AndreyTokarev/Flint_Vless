# Copy to config/nodes.conf. One node per line, whitespace separated:
# code  address  serverName(SNI)  publicKey(pbk)  shortId(sid)  [uuid]
# Values come from the vless:// link: vless://UUID@ADDRESS:443?sni=SNI&pbk=PBK&sid=SID...
# The optional 6th column overrides VLESS_UUID from gru.env for that node.
auto  auto.example.net  www.example.com  PUBLIC_KEY_BASE64URL  0123456789abcdef
nl    nl-1.example.net  www.example.com  PUBLIC_KEY_BASE64URL  0123456789abcdef
